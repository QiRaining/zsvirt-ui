{
  "name": "@zsphere/ui",
  "version": "0.0.0",
  "private": true,
  "description": "ZSphere open-source workspace.",
  "keywords": [],
  "license": "GPL-3.0-only",
  "author": "zixiaobowen",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZSvirt/zsvirt-ui.git"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "affected": "nx affected",
    "build": "nx run-many --target=build --exclude=zsphere-io --parallel=8",
    "build:apps": "nx run-many --target=build --projects=$(nx show projects --with-target build | grep '^zsv-' | grep -v '^zsv-bff$' | paste -sd, -) --parallel=8",
    "build:bff": "nx run zsv-bff:build",
    "build:libs": "nx run-many --target=build --projects=$(nx show projects --with-target build | grep '^@zstack/' | paste -sd, -) --parallel=8",
    "format": "oxfmt --write \"*.{json,md,yml,yaml}\" \"**/*.{ts,tsx,js,jsx,json,css,less,md,mdx,yml,yaml}\" --config ./.oxfmtrc.json --no-error-on-unmatched-pattern",
    "format:check": "oxfmt --check \"*.{json,md,yml,yaml}\" \"**/*.{ts,tsx,js,jsx,json,css,less,md,mdx,yml,yaml}\" --config ./.oxfmtrc.json --no-error-on-unmatched-pattern",
    "graph": "nx graph",
    "lint:all": "nx run-many --target=lint:ox --all",
    "lint:fix": "pnpm lint:ox:fix",
    "lint:ox": "oxlint -c ./.oxlintrc.json .",
    "lint:ox:fix": "oxlint -c ./.oxlintrc.json . --fix",
    "nx": "nx",
    "show:projects": "nx show projects",
    "start": "pnpm build:libs && ZSV_MOCK=1 nx run-many --target=dev --projects=$(nx show projects --with-target dev | grep '^zsv-' | paste -sd, -) --parallel=19 --outputStyle=stream",
    "start:apps": "nx run-many --target=dev --projects=$(nx show projects --with-target dev | grep '^zsv-' | grep -v '^zsv-bff$' | paste -sd, -) --parallel=32 --outputStyle=stream",
    "start:bff": "ZSV_MOCK=1 nx run zsv-bff:dev --outputStyle=stream",
    "security:audit:cve": "pnpm audit --audit-level high",
    "security:audit:licenses": "node ci/security/audit-direct-licenses.mjs --check",
    "security:report:licenses": "node ci/security/audit-direct-licenses.mjs --output security/direct-dependency-licenses.md"
  },
  "devDependencies": {
    "@module-federation/rsbuild-plugin": "2.8.1",
    "@nx/js": "22.7.7",
    "@rollup/plugin-alias": "^5.1.1",
    "@rsbuild/core": "2.0.0",
    "@rsbuild/plugin-css-minimizer": "2.0.0",
    "@rsbuild/plugin-less": "catalog:",
    "@rsbuild/plugin-react": "catalog:",
    "@rsbuild/plugin-svgr": "2.0.0",
    "@rsbuild/plugin-type-check": "1.3.4",
    "@rsdoctor/rspack-plugin": "1.5.16",
    "@rslib/core": "catalog:",
    "@rspack/core": "2.0.0",
    "@swc/core": "^1.15.11",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.19.33",
    "@types/qs": "6.9.18",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@unocss/postcss": "66.1.0-beta.7",
    "@vitejs/plugin-react": "catalog:",
    "@vitejs/plugin-react-swc": "catalog:",
    "code-inspector-plugin": "1.3.6",
    "core-js": "^3.48.0",
    "less": "^4.5.1",
    "mysql2": "^3.22.5",
    "nx": "22.7.7",
    "oxfmt": "^0.41.0",
    "oxlint": "1.56.0",
    "postcss": "8.5.23",
    "prop-types": "^15.8.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "rollup-preserve-directives": "^1.1.3",
    "typescript": "5.9.3",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vite-plugin-svgr": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.9.0"
}
