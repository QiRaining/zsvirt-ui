{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "parallel": 8,
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/*.spec.ts",
      "!{projectRoot}/**/*.spec.tsx",
      "!{projectRoot}/**/*.test.ts",
      "!{projectRoot}/**/*.test.tsx",
      "!{projectRoot}/**/__tests__/**/*",
      "!{projectRoot}/**/test/**/*",
      "!{projectRoot}/**/*.stories.ts",
      "!{projectRoot}/**/*.stories.tsx"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/pnpm-workspace.yaml",
      "{workspaceRoot}/pnpm-lock.yaml",
      "{workspaceRoot}/patches/**/*",
      "{workspaceRoot}/tsconfig.json",
      "{workspaceRoot}/tsconfig.base.json"
    ]
  },
  "plugins": [
    {
      "plugin": "@nx/js/typescript",
      "options": {
        "typecheck": {
          "targetName": "typecheck"
        },
        "build": {
          "targetName": "build",
          "configName": "tsconfig.lib.json",
          "buildDepsName": "build-deps",
          "watchDepsName": "watch-deps"
        }
      }
    }
  ],
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist", "{projectRoot}/lib"],
      "cache": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "cache": true
    },
    "type-check": {
      "dependsOn": ["^type-check"],
      "inputs": ["production", "^production"],
      "cache": true
    },
    "lint": {
      "dependsOn": ["^lint"],
      "inputs": ["default", "{workspaceRoot}/.oxlintrc.json"],
      "cache": true
    },
    "lint:ox": {
      "dependsOn": ["^lint:ox"],
      "inputs": ["default", "{workspaceRoot}/.oxlintrc.json"],
      "cache": true
    },
    "lint:json": {
      "dependsOn": ["^lint:json"],
      "inputs": ["default", "{workspaceRoot}/.oxlintrc.json"],
      "outputs": ["{projectRoot}/lint_report"],
      "cache": true
    },
    "lint:json:ox": {
      "dependsOn": ["^lint:json:ox"],
      "inputs": ["default", "{workspaceRoot}/.oxlintrc.json"],
      "outputs": ["{projectRoot}/lint_report"],
      "cache": true
    },
    "lint:ox:fix": {
      "cache": false
    },
    "format": {
      "cache": false
    },
    "format:check": {
      "inputs": ["default", "{workspaceRoot}/.oxfmtrc.json"],
      "cache": true
    },
    "test": {
      "inputs": ["default", "^production"],
      "cache": true
    },
    "test:cov": {
      "inputs": ["default", "^production"],
      "outputs": ["{projectRoot}/coverage"],
      "cache": true
    },
    "test:coverage": {
      "inputs": ["default", "^production"],
      "outputs": ["{projectRoot}/coverage"],
      "cache": true
    }
  },
  "defaultBase": "main",
  "analytics": false
}
