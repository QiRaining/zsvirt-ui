{
  "name": "@zstack/unifie",
  "version": "2.1.3",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "module": "./dist/unifie.js",
  "typings": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": {
        "default": "./dist/unifie.js"
      }
    },
    "./dist/style.css": {
      "import": "./dist/style.css",
      "require": "./dist/style.css"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "type-check": "pnpm tsgo --noEmit",
    "build": "vite build",
    "lint": "oxlint src/**",
    "lint:json": "mkdir -p ./lint_report && oxlint src/** --format json > ./lint_report/oxlint.json",
    "size": "vite build && size-limit"
  },
  "dependencies": {
    "@zstack/auth": "workspace:*",
    "@zstack/design": "workspace:*",
    "@zstack/form": "workspace:*",
    "@zstack/hooks": "workspace:*",
    "@zstack/icon": "workspace:*",
    "@zstack/utils": "workspace:*"
  },
  "devDependencies": {
    "@size-limit/preset-big-lib": "^11.1.4",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "size-limit": "^11.1.4",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "*",
    "react": "^16.8 || ^17.0 || ^18.0",
    "react-dom": "^16.8 || ^17.0 || ^18.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "@types/react-dom": {
      "optional": true
    }
  },
  "size-limit": [
    {
      "path": "dist/unifie.js",
      "limit": "399 KB"
    },
    {
      "path": "dist/unifie.umd.cjs",
      "limit": "399 KB"
    }
  ]
}
