{
  "name": "@zstack/design",
  "version": "3.2.2",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "module": "./dist/design.es.js",
  "typings": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/design.es.js"
    },
    "./dist/style.css": {
      "import": "./dist/style.css",
      "require": "./dist/style.css"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "type-check": "pnpm tsgo --noEmit",
    "build": "vite build",
    "lint:ox": "oxlint -c ../../.oxlintrc.json src",
    "lint:ox:fix": "oxlint -c ../../.oxlintrc.json src --fix",
    "lint": "pnpm run lint:ox",
    "lint:json": "pnpm run lint:json:ox",
    "lint:json:ox": "mkdir -p ./lint_report && oxlint -c ../../.oxlintrc.json src --format json > ./lint_report/oxlint.json",
    "size": "vite build && size-limit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hookform/resolvers": "catalog:",
    "@radix-ui/react-checkbox": "catalog:",
    "@radix-ui/react-dialog": "catalog:",
    "@radix-ui/react-dropdown-menu": "catalog:",
    "@radix-ui/react-label": "catalog:",
    "@radix-ui/react-popover": "catalog:",
    "@radix-ui/react-progress": "catalog:",
    "@radix-ui/react-radio-group": "catalog:",
    "@radix-ui/react-select": "catalog:",
    "@radix-ui/react-slider": "catalog:",
    "@radix-ui/react-slot": "catalog:",
    "@radix-ui/react-switch": "catalog:",
    "@radix-ui/react-tabs": "catalog:",
    "@radix-ui/react-toast": "catalog:",
    "@radix-ui/react-tooltip": "catalog:",
    "@tanstack/react-table": "catalog:",
    "@uiw/codemirror-extensions-langs": "catalog:",
    "@uiw/react-codemirror": "catalog:",
    "@zstack/hooks": "workspace:*",
    "@zstack/i18n": "workspace:*",
    "@zstack/icon": "workspace:*",
    "@zstack/utils": "workspace:*",
    "class-variance-authority": "catalog:",
    "github-markdown-css": "5.7.0",
    "immer": "catalog:",
    "lodash-es": "catalog:",
    "prismjs": "catalog:",
    "react-arborist": "^3.4.3",
    "react-day-picker": "catalog:",
    "react-hook-form": "catalog:",
    "react-intl": "catalog:",
    "react-markdown": "^9.0.1",
    "react-resizable-panels": "catalog:",
    "react-router": "catalog:",
    "recharts": "catalog:",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "4.0.0",
    "single-spa": "catalog:",
    "spark-md5": "^3.0.2",
    "tw-animate-css": "^1.4.0",
    "uuid": "catalog:",
    "zod": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@size-limit/preset-big-lib": "^11.1.4",
    "@tailwindcss/postcss": "catalog:",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/react-hooks": "^8.0.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "less": "^4.2.0",
    "postcss": "^8.5.6",
    "prop-types": "^15.8.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "size-limit": "^11.1.4",
    "tailwindcss": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "*",
    "react": "^16.8 || ^17.0 || ^18.0",
    "react-dom": "^16.8 || ^17.0 || ^18.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "@types/react-dom": {
      "optional": true
    }
  },
  "size-limit": [
    {
      "path": "dist/design.es.js",
      "limit": "399 KB"
    }
  ]
}
