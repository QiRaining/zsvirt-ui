{
  "name": "@zstack/zsphere-engine",
  "version": "1.2.2",
  "description": "ZStack code generate engine",
  "author": "ZStack UI Team",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "module": "./dist/engine.js",
  "exports": {
    "./src/*": {
      "import": "./dist/src/*",
      "types": [
        "./dist/src/*/index.d.ts",
        "./dist/src/*.d.ts"
      ]
    },
    "./utils": {
      "import": "./dist/utils/index.js",
      "types": "./dist/utils/index.d.ts"
    },
    "./utils/*": {
      "import": "./dist/utils/*",
      "types": [
        "./dist/utils/*/index.d.ts",
        "./dist/utils/*.d.ts"
      ]
    },
    "./core/*": {
      "import": "./dist/core/*",
      "types": [
        "./dist/core/*/index.d.ts",
        "./dist/core/*.d.ts"
      ]
    },
    "./*": {
      "import": "./dist/*",
      "types": [
        "./dist/*/index.d.ts",
        "./dist/*.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@apollo/client": "catalog:",
    "@zstack/design": "workspace:*",
    "@zstack/hooks": "workspace:*",
    "@zstack/zsphere-components": "workspace:*",
    "@zstack/zsphere-config": "workspace:*",
    "@zstack/zsphere-constant": "workspace:*",
    "@zstack/zsphere-design-biz": "workspace:*",
    "@zstack/zsphere-hooks": "workspace:*",
    "@zstack/zsphere-types": "workspace:*",
    "@zstack/zsphere-utils": "workspace:*",
    "copy-to-clipboard": "3.3.3",
    "immer": "10.1.1",
    "lodash-es": "4.18.1",
    "pascal-case": "^3.1.1",
    "react-intl": "catalog:",
    "react-router": "catalog:"
  },
  "devDependencies": {
    "@rslib/core": "catalog:",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "peerDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "nx": {
    "tags": [
      "scope:zsv",
      "product:zsv"
    ]
  }
}
