{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "assets": [
      {
        "include": "auth/**/*.json",
        "outDir": "dist"
      }
    ],
    "tsConfigPath": "tsconfig.json",
    "deleteOutDir": true,
    "builder": "swc",
    "typeCheck": true
  }
}
