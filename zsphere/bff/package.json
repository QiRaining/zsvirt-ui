{
  "name": "zsv-bff",
  "version": "5.0.0",
  "private": true,
  "description": "",
  "license": "GPL-3.0-only",
  "author": "zixiaobowen",
  "scripts": {
    "types": "pnpm graphql-codegen",
    "types:dev": "pnpm graphql-codegen --watch",
    "types:plugin": "cp src/types/plugin.d.ts ../zstack-ui/main/src/types",
    "prebuild": "rimraf dist",
    "build": "nest build",
    "build-prod": "rimraf dist && nest build -c nest-cli.prod.json -p tsconfig.prod.json",
    "format": "oxfmt --write . --config ./.oxfmtrc.json --no-error-on-unmatched-pattern",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug 3101 --watch",
    "nowatch": "nest start --debug 3101",
    "start:prod": "node dist/main",
    "lint": "pnpm run lint:ox",
    "test": "jest",
    "test:unit": "jest --testPathPattern='__test__/' --verbose --no-coverage",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "node --expose-gc --max-old-space-size=28672  node_modules/.bin/jest --runInBand --logHeapUsage --forceExit --config ./test/jest-e2e.json",
    "test:e2e:cov": "node --expose-gc --max-old-space-size=28672 node_modules/.bin/jest --coverage --logHeapUsage --forceExit --colors --runInBand --config ./test/jest-e2e.json",
    "test:cov:server": "http-server ./coverage-e2e/lcov-report",
    "test:e2e:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --forceExit --runInBand --config ./test/jest-e2e.json",
    "analyze": "node tools/analyze/index.js",
    "format:check": "oxfmt --check . --config ./.oxfmtrc.json --no-error-on-unmatched-pattern",
    "lint:ox": "oxlint -c ./.oxlintrc.json src",
    "lint:ox:fix": "oxlint -c ./.oxlintrc.json src --fix",
    "lint:json": "pnpm run lint:json:ox",
    "lint:json:ox": "mkdir -p ./lint_report && oxlint -c ./.oxlintrc.json src --format json > ./lint_report/oxlint.json"
  },
  "dependencies": {
    "@apollo/client": "catalog:",
    "@apollo/server": "5.5.1",
    "@as-integrations/fastify": "3.1.0",
    "@fastify/multipart": "10.1.0",
    "@fastify/static": "10.1.2",
    "@graphql-tools/mock": "^9.0.23",
    "@graphql-tools/utils": "^10.6.1",
    "@nestjs/apollo": "13.4.2",
    "@nestjs/axios": "^4.0.0",
    "@nestjs/cache-manager": "^3.0.0",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "11.1.28",
    "@nestjs/graphql": "13.4.2",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/platform-fastify": "11.1.28",
    "@nestjs/schedule": "^5.0.0",
    "@nestjs/sequelize": "11.0.0",
    "@nestjs/serve-static": "^5.0.1",
    "apollo-server-errors": "^3.3.1",
    "axios": "1.19.0",
    "bluebird": "^3.7.2",
    "body-parser": "1.20.6",
    "cache-manager": "6.3.2",
    "cache-manager-redis-store": "^3.0.1",
    "chokidar": "^5.0.0",
    "cron": "3.1.7",
    "cross-fetch": "^4.0.0",
    "crypto-js": "^4.2.0",
    "dataloader": "^2.2.2",
    "dayjs": "catalog:",
    "express": "^4.21.2",
    "fastify": "5.11.2",
    "form-data": "^4.0.1",
    "fuse.js": "6.4.2",
    "graphql": "16.11.0",
    "graphql-fields": "^2.0.3",
    "graphql-redis-subscriptions": "^2.6.1",
    "graphql-scalars": "^1.24.2",
    "graphql-subscriptions": "^3.0.0",
    "graphql-tag": "^2.12.6",
    "graphql-tools": "^9.0.5",
    "iconv-lite": "^0.6.3",
    "immer": "^10.0.4",
    "ioredis": "^5.4.1",
    "ip-address": "10.4.0",
    "js-yaml": "4.3.0",
    "lodash": "^4.17.21",
    "mariadb": "^3.4.5",
    "md5": "^2.3.0",
    "md5.js": "^1.3.5",
    "module-alias": "^2.2.3",
    "mysql2": "^3.11.5",
    "node-cron": "^3.0.3",
    "node-fetch": "2.7.0",
    "pdfkit": "^0.15.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "sequelize": "^6.37.5",
    "sequelize-typescript": "^2.1.6",
    "sinon": "21.0.3",
    "svg-to-pdfkit": "^0.1.8",
    "unzipper": "^0.12.3",
    "uuid": "11.1.1",
    "ws": "8.21.0",
    "yargs": "^17.7.2",
    "yargs-parser": "^21.1.1"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.3",
    "@graphql-codegen/typescript": "^4.1.2",
    "@graphql-codegen/typescript-operations": "^4.4.0",
    "@graphql-codegen/typescript-react-apollo": "^4.3.2",
    "@graphql-tools/schema": "^10.0.33",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "11.1.28",
    "@parcel/watcher": "^2.5.1",
    "@swc/cli": "^0.8.0",
    "@swc/core": "^1.15.21",
    "@types/cache-manager": "2.10.3",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.3.1",
    "@types/node-fetch": "^2.6.12",
    "@types/pdfkit": "^0.13.6",
    "@types/supertest": "^2.0.12",
    "@types/svg-to-pdfkit": "^0.1.3",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.5.13",
    "chalk": "4",
    "dotenv": "^16.4.7",
    "jest": "^29.5.0",
    "jest-html-reporters": "2.1.6",
    "node-html-parser": "2.0.0",
    "rimraf": "^5.0.5",
    "source-map-support": "^0.5.21",
    "sqlite3": "^6.0.1",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.8.2",
    "oxfmt": "^0.41.0",
    "oxlint": "1.56.0"
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS",
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}": [
      "oxlint -c ./.oxlintrc.json --fix",
      "oxfmt --write --config ./.oxfmtrc.json --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc}": [
      "oxfmt --write --config ./.oxfmtrc.json --no-error-on-unmatched-pattern"
    ]
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.spec.ts",
      "!src/api/**"
    ],
    "coverageDirectory": "coverage-e2e",
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "moduleNameMapper": {
      "@/(.*)": "<rootDir>/src/$1",
      "@test/(.*)": "<rootDir>/test/$1"
    },
    "reporters": [
      "default",
      "jest-html-reporters"
    ],
    "rootDir": ".",
    "setupFilesAfterEnv": [
      "./test/jest.setup.ts"
    ],
    "testEnvironment": "node",
    "testRegex": ".(spec|e2e-spec).ts$",
    "testTimeout": 600000,
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    }
  },
  "nx": {
    "tags": [
      "scope:zsv",
      "product:zsv"
    ]
  }
}
