NODE_ENV=development

HOST=127.0.0.1
ZSV_BFF_PORT=3100

ZS_MN_SERVER=http://127.0.0.1:8080
ZS_MYSQL_HOST=127.0.0.1
ZS_MYSQL_PORT=3306
ZS_MYSQL_USERNAME=root
ZS_MYSQL_PASSWORD=password
ZS_REDIS_HOST=127.0.0.1
ZS_REDIS_PORT=6379
ZS_REDIS_TTL=9
ZS_ACTION_TIMEOUT=3600
ZS_UI_LOGGER_DIR=../

# UI 实时展示调用 API 情况
API_INSPECTOR=false
# 数据采集开关
INTERACTIVE_COLLECT=false

# 资源树自定义排序开关
CUSTOM_TREE_SORT=false
# 自定义排序规则配置文件路径（默认为当前目录下的 custom-tree-sort.json）
# CUSTOM_TREE_SORT_CONFIG=/etc/zstack-ui/custom-tree-sort.json

# 开放平台菜单开关
OPEN_PLATFORM=false

# 漏扫权限检查开关 (毕马威), 对应 `zstack-ctl config_ui --priv-check=true`
ZS_UI_PRIV_CHECK=true
